<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".MainActivity">

    <!-- Background overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:alpha="0.93" />

    <!-- Airplane illustration (more subtle) -->
    <ImageView
        android:id="@+id/yourImageView"
        android:layout_width="300dp"
        android:layout_height="200dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="-50dp"
        android:layout_marginBottom="50dp"
        android:alpha="0.1"
        android:src="@drawable/plane" />

    <!-- Top section with greeting -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginTop="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello, Traveler! ✈️"
            android:textSize="16sp"
            android:textColor="@color/neutral_600"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/let_s_find_out_how_to_get"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary_blue"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/to_the_plane"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/primary_light_blue"
            android:layout_marginBottom="32dp" />

    </LinearLayout>

    <!-- Main content card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerSection"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="24dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flight Information"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_800"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Airline"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_700"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/airlineSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/input_field_background"
            android:padding="16dp"
            android:contentDescription="@string/select_airline_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/what_is_your_flight_number"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_700"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/textInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_field_background"
            android:hint="@string/flight_number_hint"
            android:padding="16dp"
            android:textColor="@color/neutral_800"
            android:textColorHint="@color/neutral_400"
            android:inputType="textCapCharacters"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/findWayButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/find_the_way"
            android:background="@drawable/button_primary"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="4dp" />

        <!-- Quick tips section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="@color/neutral_50"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡"
                android:textSize="20sp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enter your flight number to get real-time navigation to your gate"
                android:textSize="12sp"
                android:textColor="@color/neutral_600"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>